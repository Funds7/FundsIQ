rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // User profile documents contain private and financial fields.
    // The owner may read their own profile, but clients cannot create,
    // modify, or delete profile, Premium, coin, marketer, or score fields.
    // Trusted backend code uses Firebase Admin and bypasses these rules.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list, create, update, delete: if false;

      // Personal exam records. These are not used as trusted leaderboard
      // scores; leaderboard data is served by the authenticated backend.
      match /results/{resultId} {
        allow read, write: if isOwner(userId);
      }

      match /examHistory/{examId} {
        allow read, write: if isOwner(userId);
      }

      // User-owned academic planning data.
      match /timetable/{itemId} {
        allow read, write: if isOwner(userId);
      }

      match /courses/{courseId} {
        allow read, write: if isOwner(userId);
      }

      // Referral records and notifications are backend-created.
      match /referrals/{referralId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }
    }

    // Referral-code ownership and marketer financial totals must only be
    // changed by trusted backend code, never directly from a browser.
    match /referralCodes/{referralCode} {
      allow read, write: if false;
    }

    // Deny every collection not explicitly opened above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
